# ──────────────────────────────────────────
# Frontend — variables de entorno (Vite)
# Copia este archivo como .env y ajusta
# ──────────────────────────────────────────

# Desarrollo local (backend en :8080)
VITE_API_URL=http://localhost:8080

# Alternativa con proxy de Vite (requiere rutas sin prefijo /api en el código)
# VITE_API_URL=

# Producción / remoto (descomentar y comentar la línea de arriba)
# VITE_API_URL=https://i2u6hsbhf1.execute-api.us-east-2.amazonaws.com

# YOLOv11 — en dev usar proxy Vite (evita CORS del navegador)
VITE_YOLO_API_URL=/yolo

# Si despliegas el frontend en producción sin proxy, usa la URL directa
# (el backend YOLO debe tener CORS habilitado)
# VITE_YOLO_API_URL=http://34.144.186.210:8000
