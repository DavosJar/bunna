# ──────────────────────────────────────────
# Frontend — variables de entorno (Vite)
# Copia este archivo como .env y ajusta
# ──────────────────────────────────────────

# Identidad (desarrollo local)
VITE_API_URL=http://localhost:8080

# YOLOv11 — proxy Vite
VITE_YOLO_API_URL=/yolo

# Fincas — proxy Vite (puerto 8082, requiere backend fincas corriendo)
VITE_FINCAS_API_URL=/fincas

