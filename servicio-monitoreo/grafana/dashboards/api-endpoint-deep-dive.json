            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT count()/dateDiff('second', toStartOfInterval(min(timestamp), INTERVAL 1 MINUTE), toStartOfInterval(max(timestamp), INTERVAL 1 MINUTE) + INTERVAL 1 MINUTE) FROM telemetria_api WHERE $__timeFilter(timestamp) AND path = '$endpoint'",
          "format": "table",
          "interval": ""
        }
