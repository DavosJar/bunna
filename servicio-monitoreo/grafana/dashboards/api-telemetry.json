{
  "title": "API - Telemetr\u00eda",
  "uid": "api-telemetry",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "bunna",
    "api",
    "telemetria",
    "monitoreo"
  ],
  "schemaVersion": 36,
  "version": 1,
  "panels": [
    {
      "title": "Throughput",
      "type": "timeseries",
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "displayMode": "list",
            "spanNulls": false,
            "showPoints": "auto",
            "lineInterpolation": "smooth",
            "gradientMode": "opacity",
            "fillOpacity": 50,
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "bars"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL 1 MINUTE) AS t, count() AS total FROM telemetria_api WHERE $__timeFilter(timestamp) GROUP BY t ORDER BY t",
          "format": "table",
          "interval": ""
        }
      ]
    },
    {
      "title": "Latencia P50 / P95 / P99",
      "type": "timeseries",
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "displayMode": "list",
            "spanNulls": false,
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "gradientMode": "opacity",
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL 1 MINUTE) AS t, avg(duration_ms) AS p50, quantile(0.95)(duration_ms) AS p95, quantile(0.99)(duration_ms) AS p99 FROM telemetria_api WHERE $__timeFilter(timestamp) GROUP BY t ORDER BY t",
          "format": "table",
          "interval": ""
        }
      ]
    },
    {
      "title": "Status Codes",
      "type": "timeseries",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "displayMode": "list",
            "spanNulls": false,
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "gradientMode": "opacity",
            "fillOpacity": 30
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/2\\d\\d/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/4\\d\\d/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/5\\d\\d/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL 1 MINUTE) AS t, status_code, count() AS total FROM telemetria_api WHERE $__timeFilter(timestamp) GROUP BY t, status_code ORDER BY t",
          "format": "table",
          "interval": ""
        }
      ]
    },
    {
      "title": "Endpoints Populares",
      "type": "barchart",
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": ""
            },
            "orientation": "horizontal",
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "bars",
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 0,
            "pointSize": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "total"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Total Solicitudes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duracion_promedio_ms"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Duraci\u00f3n Prom. (ms)"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "sortBy": "total",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT path, count() AS total, avg(duration_ms) AS duracion_promedio_ms FROM telemetria_api WHERE $__timeFilter(timestamp) GROUP BY path ORDER BY total DESC LIMIT 10",
          "format": "table",
          "interval": ""
        }
      ]
    }
  ]
}
