      {
        "name": "service_name",
        "type": "query",
        "query": "SELECT DISTINCT service_name FROM telemetria_api WHERE service_name != '' ORDER BY service_name",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": "",
        "hide": 0,
        "label": "Service",
        "multi": false,
        "skipUrlSync": false
      },
      {
        "name": "endpoint",
        "type": "query",
        "query": "SELECT DISTINCT path FROM telemetria_api WHERE service_name = '$service_name' ORDER BY path",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "allValue": "",
        "hide": 0,
        "label": "Endpoint",
        "multi": false,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
