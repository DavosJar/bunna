# ──────────────────────────────────────────
# Identidad — variables de entorno
# Copia este archivo como .env y ajusta los valores
# ──────────────────────────────────────────

# ─── Base de datos (PostgreSQL RDS) ───
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSLMODE=require

# ─── Servidor ───
PORT=8080

# ─── JWT ───
JWT_SECRET=supersecreto_cambiar_en_prod
JWT_ISSUER=identidad.bunna
JWT_ACCESS_EXPIRACION=15m
JWT_REFRESH_EXPIRACION=24h

# ─── CORS / API Gateway ───
CORS_ORIGINS=*
API_GATEWAY_ENABLED=false
# true  = el API Gateway maneja CORS, el backend no agrega headers
# false = el backend permite cualquier origen (*)

# ─── Frontend ───
FRONTEND_URL=http://localhost:5173

# ─── Bcrypt ───
BCRYPT_COST=12

# ─── Bloqueo de cuentas ───
CUENTA_BLOQUEO_MAX_INTENTOS=5
CUENTA_BLOQUEO_DURACION=15m

# ─── Bloqueo por IP ───
BLOQUEO_IP_MAX_INTENTOS=15
BLOQUEO_IP_VENTANA=15m
BLOQUEO_IP_DURACION=30m

# ─── Rate limiting ───
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_VENTANA=1m

# ─── Sesiones ───
SESION_TIMEOUT_INACTIVIDAD=30m
SESION_TIMEOUT_ABSOLUTO=168h
SESION_MAX_REFRESCOS=0

# ─── SMTP (correo) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
EMAIL_ASYNC=true

# ─── Verificación de correo ───
VERIFICACION_TOKEN_EXPIRACION=24h
VERIFICACION_MAX_REENVIOS=5
VERIFICACION_VENTANA_REENVIOS=24h

# ─── Recuperación de contraseña ───
RECUPERACION_TOKEN_EXPIRACION=1h
RECUPERACION_RATE_LIMIT_IP_MAX=3
RECUPERACION_RATE_LIMIT_USUARIO_MAX=1
RECUPERACION_RATE_LIMIT_VENTANA=15m

# ─── Rate Limiting Middleware (IP) ───
RATE_LIMIT_IP_MAX_REQUESTS=10
RATE_LIMIT_IP_VENTANA=1s
