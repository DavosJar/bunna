      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "rawSql": "SELECT count() FROM telemetria_api WHERE $__timeFilter(timestamp) AND path = '$endpoint'",
          "format": "table",
          "interval": ""
